---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const poems = (await getCollection("poems"))
  .filter((poem) => poem.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Kho thơ | Mèo Đen Không Ngủ"
  description="Toàn bộ kho thơ của Mèo Đen Không Ngủ."
  current="poems"
  bodyClass="archive-page"
>
  <section class="archive-intro" aria-labelledby="archive-title">
    <h1 id="archive-title">Mỗi bài thơ là<br /><em>một căn phòng.</em></h1>
    <p>Từng bài thơ là một lát cắt cảm xúc trong những đêm không ngủ.</p>
  </section>

  <section class="archive-gallery" aria-label="Danh sách bài thơ">
    <div class="archive-controls">
      <label class="search-field">
        <span>Tìm trong kho thơ</span>
        <input type="search" placeholder="Nhập tên bài hoặc một câu gợi nhớ…" autocomplete="off" data-poem-search />
      </label>
      <button class="wander-button" type="button" data-archive-wander>Để Mèo dẫn lối <span aria-hidden="true">↗</span></button>
    </div>

    <p class="archive-result" aria-live="polite" data-result-count>{poems.length} bài thơ</p>

    <div class="archive-grid" data-poem-list>
      {poems.map((poem, index) => (
        <a
          class="archive-card"
          href={`/tho/${poem.id.replace(/\.md$/, "")}`}
          data-search-text={`${poem.data.title} ${poem.data.excerpt ?? ""} ${poem.data.collection ?? ""}`.toLocaleLowerCase("vi-VN")}
        >
          <span class="card-number">{String(index + 1).padStart(3, "0")}</span>
          <span class="card-theme">{poem.data.collection ?? "Thơ"}</span>
          <h2>{poem.data.title}</h2>
          {poem.data.excerpt && <p>{poem.data.excerpt}</p>}
          <span class="card-status">Đọc bài</span>
        </a>
      ))}
    </div>

    <p class="empty-state" data-empty-state hidden>Chưa tìm thấy bài thơ phù hợp.</p>
  </section>

  <script slot="scripts" is:inline src="/poem-filters.js"></script>
</BaseLayout>
