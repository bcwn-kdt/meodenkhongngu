---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const poems = await getCollection("poems");

  return poems
    .filter((poem) => poem.data.published)
    .map((poem) => ({
      params: { slug: poem.id.replace(/\.md$/, "") },
      props: { poem },
    }));
}

const { poem } = Astro.props;
const { Content } = await render(poem);
const layout = poem.data.layout;
const lineSpacing = poem.data.lineSpacing;
---

<BaseLayout
  title={`${poem.data.title} | Mèo Đen Không Ngủ`}
  description={poem.data.excerpt ?? `Đọc “${poem.data.title}” của Mèo Đen Không Ngủ.`}
  current="poems"
  bodyClass="poem-reader-page"
>
  <article class:list={["poem-page", `poem-exhibit--${layout}`]}>
    <a class="back-link" href="/tho">← Trở về kho thơ</a>

    <header class="poem-header">
      <p class="eyebrow">{poem.data.collection ?? "Mèo Đen Không Ngủ"}</p>
      <h1>{poem.data.title}</h1>
      <div class="meta">
        <span>{poem.data.date.toLocaleDateString("vi-VN")}</span>
        {poem.data.chapter && <span> · {poem.data.chapter}</span>}
        {poem.data.mood && <span> · {poem.data.mood}</span>}
      </div>
    </header>

    <div class:list={["poem-content", `poem-spacing--${lineSpacing}`]}>
      <Content />
    </div>

    <footer class="poem-signoff">
      <span>MĐKN</span>
      <a class="quiet-link" href="/tho">Đọc một bài khác</a>
    </footer>
  </article>
</BaseLayout>
