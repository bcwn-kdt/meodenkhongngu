---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const published = (await getCollection("poems"))
  .filter((poem) => poem.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const exhibition = published.slice(0, 20).map((poem, index) => ({
  poem,
  number: String(index + 1).padStart(3, "0"),
  cardClass: index === 0 ? "featured" : [3, 11].includes(index) ? "tall" : [6, 14].includes(index) ? "wide" : "",
}));
---

<BaseLayout>
  <section id="entrance" class="entrance" aria-labelledby="intro-title">
    <div class="hero-art" aria-hidden="true">
      <img src="/art/night-portrait.jpg" width="640" height="640" alt="" fetchpriority="high" />
    </div>
    <div class="entrance-copy">
      <p class="eyebrow">Mèo Đen Không Ngủ · Black Cat White Night</p>
      <h1 id="intro-title">Có những vết thương không bao giờ biến mất,<br /><em>chỉ là mình học cách sống cùng chúng — một cách tử tế.</em></h1>

      <div class="opening-note">
        <span class="opening-label">Lời mở đầu</span>
        <p class="opening-lead">Mèo không phải là một người viết thơ.</p>
        <p>Chỉ là thơ tìm đến Mèo từ những năm mình chập chững tuổi mười tám.</p>
        <p>Mèo bắt đầu viết từ những suy nghĩ rất riêng, với tất cả những cảm xúc, những rung cảm mà khi ấy mình chưa biết phải gọi tên thế nào.</p>
        <a class="quiet-link" href="/ve-meo">Đọc lời tâm tư từ Mèo</a>
      </div>

      <div class="entrance-actions">
        <a class="enter-button" href="#gallery">
          <span>Bước vào kho thơ</span>
          <svg viewBox="0 0 48 16" aria-hidden="true"><path d="M0 8h44M37 1l7 7-7 7" /></svg>
        </a>
        <a class="quiet-link" href="/tho">Xem toàn bộ {published.length} bài thơ</a>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span></span>Cuộn để bước vào</div>
  </section>

  <section id="gallery" class="gallery" aria-labelledby="gallery-title">
    <div class="gallery-heading">
      <div>
        <p class="eyebrow">Trích từ kho thơ</p>
        <h2 id="gallery-title">Đi theo điều<br />đang ở lại trong mình.</h2>
      </div>
      <p class="gallery-note">Một tuyển chọn từ những bài thơ đã có trong kho. Chạm vào một nhan đề để bước vào bài viết.</p>
    </div>

    <div class="poem-grid" aria-live="polite" data-exhibition-grid>
      {exhibition.map((item) => (
        <a class:list={["poem-card", item.cardClass]} href={`/tho/${item.poem.id.replace(/\.md$/, "")}`}>
          <span class="card-number">{item.number}</span>
          <span class="card-theme">{item.poem.data.collection ?? "Kho thơ"}</span>
          <strong>{item.poem.data.title}</strong>
          <span class="card-status">Đọc bài</span>
        </a>
      ))}
    </div>

    <div class="wander">
      <p>Không biết nên bắt đầu từ đâu?</p>
      <button class="wander-button" type="button" data-wander>Để Mèo dẫn lối <span aria-hidden="true">↗</span></button>
    </div>
  </section>

</BaseLayout>
