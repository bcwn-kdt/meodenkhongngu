---
const { current = "" } = Astro.props;

const navItems = [
  { key: "poems", label: "Kho thơ", href: "/tho" },
  { key: "book", label: "Va Vào Lần Yêu Cuối", href: "/tap-tho/va-vao-lan-yeu-cuoi" },
  { key: "about", label: "Về Mèo", href: "/ve-meo" },
];
---

<header class="site-header" data-site-header>
  <a class="wordmark" href="/" aria-label="Mèo Đen Không Ngủ — trang chủ">
    <span class="cat-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" role="img">
        <path d="M7.4 10.6 9 4.9l5.1 3.3c.6-.1 1.2-.2 1.9-.2s1.3.1 1.9.2L23 4.9l1.6 5.7A10.8 10.8 0 1 1 7.4 10.6Z" />
        <path d="M11.8 15.4h.1m8.2 0h.1M12.5 20c2.2 1.6 4.8 1.6 7 0" />
      </svg>
    </span>
    <span>MĐKN</span>
  </a>

  <nav aria-label="Điều hướng chính">
    {navItems.map((item) => (
      <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>
</header>
