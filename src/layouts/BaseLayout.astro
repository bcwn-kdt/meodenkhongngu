---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  current?: "poems" | "book" | "about" | "";
  bodyClass?: string;
}

const {
  title = "Mèo Đen Không Ngủ",
  description = "Mèo Đen Không Ngủ — một không gian đọc thơ về tình yêu, chia ly, tổn thương và hành trình học cách bước tiếp.",
  current = "",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon-cat-moon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Đi tới nội dung chính</a>
    <SiteHeader current={current} />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <script is:inline src="/site.js"></script>
    <script is:inline src="/ambient.js"></script>
    <script is:inline src="/scroll-effects.js"></script>
    <slot name="scripts" />
  </body>
</html>
